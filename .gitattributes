# Reviewed manifest and retained HTTP response digests must survive checkout.
data/nominees/*.json text eol=lf
artifacts/lane-c/real-roster-payloads/*.json text eol=lf
# Immutable receiving review bundles retain their captured byte digests.
artifacts/lane-c/real-roster-payloads-extended/** -text whitespace=cr-at-eol
artifacts/lane-c/review-b-source-coverage/** -text whitespace=cr-at-eol
artifacts/lane-c/fec-expanded/** -text whitespace=cr-at-eol

# FEC review receipts and frozen source snapshots retain their reviewed bytes.
artifacts/fec-first/*.json text eol=lf
artifacts/fec-first/original-core/**/*.ts text eol=lf
# Calendar correction receipts and actual roster captures retain their digest bytes.
artifacts/la-catalog/current-independent-*.json text eol=lf
artifacts/la-catalog/main-refresh/** -text whitespace=cr-at-eol
tests/fixtures/real-roster/*.json -text
tests/fixtures/official-results/*.json -text
tests/fixtures/official-results/future-positive/*.json -text
tests/fixtures/fec/*.json text eol=lf
