  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run tests/integration tests/smoke.test.ts tests/congress.controller.spec.ts tests/congress.service.spec.ts tests/election.service.spec.ts --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:seed": "tsx scripts/seed-database.ts",
    "prepare": "node -e \"try { require('husky').install() } catch (e) { if (e.code !== 'MODULE_NOT_FOUND') throw e }\"",
    "lint": "echo 'Linting...' && tsc --noEmit",
    "test:e2e:list": "playwright test --list"
  },
